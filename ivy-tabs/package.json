{
  "name": "@puppet/ivy-tabs",
  "version": "4.0.4",
  "description": "WAI-ARIA accessible tabs for Ember. Originally created by Envy Labs",
  "keywords": [
    "ember",
    "ember-addon",
    "tabs",
    "aria",
    "accessibility"
  ],
  "homepage": "https://github.com/puppetlabs/ivy-tabs#readme",
  "bugs": {
    "url": "https://github.com/puppetlabs/ivy-tabs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppetlabs/ivy-tabs.git"
  },
  "license": "MIT",
  "author": "Dray Lacy",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache\"",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"A v2 addon does not have tests, run tests in test-app\""
  },
  "dependencies": {
    "@babel/core": "^7.27.1",
    "@embroider/addon-shim": "^1.10.0",
    "decorator-transforms": "^2.3.0",
    "@glimmer/component": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/runtime": "^7.27.1",
    "@embroider/addon-dev": "^8.0.1",
    "@eslint/js": "^9.26.0",
    "@ijlee2-frontend-configs/ember-template-lint": "^1.1.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^1.1.0",
    "@ijlee2-frontend-configs/prettier": "^1.0.0",
    "@ijlee2-frontend-configs/stylelint": "^1.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^2.4.1",
    "concurrently": "^9.1.2",
    "ember-template-lint": "^7.7.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "rollup": "^4.40.2",
    "rollup-plugin-copy": "^3.5.0",
    "stylelint": "^16.19.1"
  },
  "peerDependencies": {
    "ember-source": "^5.12.0",
    "ember-lifeline": "^7.0.0",
    "ember-modifier": "^4.2.2",
    "ember-template-imports": "^4.3.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "app-js": {
      "./components/ivy-tabs-tab.js": "./dist/_app_/components/ivy-tabs-tab.js",
      "./components/ivy-tabs-tablist.js": "./dist/_app_/components/ivy-tabs-tablist.js",
      "./components/ivy-tabs-tabpanel.js": "./dist/_app_/components/ivy-tabs-tabpanel.js",
      "./components/ivy-tabs.js": "./dist/_app_/components/ivy-tabs.js"
    },
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ]
}
